<div class="cl-main-widget-dashboard-header">
  <div class="cl-main-widget-dashboard-header-label">{{ headerLabel }}</div>
  <div class="cl-main-widget-dashboard-header-close"></div>
</div>
<div class="cl-main-widget-dashboard-body">
  {{#if isAwards}}
    <div class="cl-main-widget-dashboard-awards hidden">
      <div class="cl-main-widget-dashboard-awards-title">Available Awards</div>
      <div class="cl-main-widget-dashboard-awards-wrapp">
        <div class="cl-main-widget-dashboard-awards-list"></div>
        <div class="cl-main-widget-dashboard-awards-list-more">{{ seeAllLabel }}</div>
      </div>
    </div>
  {{/if}}
  {{#if isInstantWins}}
    <div class="cl-main-widget-dashboard-instant-wins hidden">
      <div class="cl-main-widget-dashboard-instant-wins-title">{{ instantWinsTitle }}</div>
      <div class="cl-main-widget-dashboard-instant-wins-wrapp"></div>
      <div class="cl-main-widget-dashboard-instant-wins-more">{{ seeAllLabel }}</div>
    </div>
  {{/if}}
    <div class="cl-main-widget-ach-list-popup-wrapp">
      <div class="cl-main-widget-ach-list-popup">
        <div class="cl-main-widget-ach-list-popup-title">{{ leavePopupTitle }}</div>
        <div class="cl-main-widget-ach-list-popup-close"></div>
        <div class="cl-main-widget-ach-list-popup-description">{{ leavePopupDescription }}</div>
        <div class="cl-main-widget-ach-list-popup-actions">
          <div class="cl-main-widget-ach-list-popup-cancel">{{ leavePopupActionCancel }}</div>
          <div class="cl-main-widget-ach-list-popup-confirm">{{ leavePopupActionConfirm }}</div>
        </div>
      </div>
    </div>
  {{#if isAchievements}}
    <div class="cl-main-widget-dashboard-achievements hidden">
      <div class="cl-main-widget-dashboard-achievements-title">{{ achievementsTitle }}</div>
      <div class="cl-main-widget-dashboard-achievements-wrapp">
        <div class="cl-main-widget-dashboard-achievements-list"></div>
        <div class="cl-main-widget-dashboard-achievements-list-more">{{ seeAllLabel }}</div>
      </div>
    </div>
  {{/if}}
  {{#if isTournaments}}
    <div class="cl-main-widget-dashboard-tournaments hidden">
      <div class="cl-main-widget-dashboard-tournaments-title">{{ tournamentsTitle }}</div>
      <div class="cl-main-widget-dashboard-tournaments-wrapp">
        <div class="cl-main-widget-dashboard-tournaments-list"></div>
        <div class="cl-main-widget-dashboard-tournaments-list-more">{{ seeAllLabel }}</div>
      </div>
    </div>
  {{/if}}
  {{#if isMissions}}
    <div class="cl-main-widget-dashboard-missions hidden">
      <div class="cl-main-widget-dashboard-missions-title">Missions</div>
      <div class="cl-main-widget-dashboard-missions-wrapp">
        <div class="cl-main-widget-dashboard-missions-list"></div>
        <div class="cl-main-widget-dashboard-missions-list-more">{{ seeAllLabel }}</div>
      </div>
    </div>
  {{/if}}
</div>
