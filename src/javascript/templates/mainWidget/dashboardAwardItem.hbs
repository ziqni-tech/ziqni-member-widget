<div class="cl-rew-list-details-cont">
  <div class="cl-rew-list-details-wrap">
    <div class="cl-rew-list-details-icon" {{#if iconLink}} style="background-image: url({{ iconLink }})" {{/if}}></div>
    <div class="cl-rew-list-details-data">
      <div class="cl-rew-list-details-label">{{ label }}</div>
      <div class="cl-rew-list-details-type">{{ type }}</div>
      <div class="cl-rew-list-details-prize">{{ prize }}</div>
      <div class="cl-rew-dashboard-details-claim">{{ claimBtnLabel }}</div>
    </div>
  </div>
</div>
