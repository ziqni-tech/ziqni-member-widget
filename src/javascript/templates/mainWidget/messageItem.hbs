<div class="cl-inbox-list-details-cont">
  <label class="checkbox-container">
    <input type="checkbox" name="checkMessage" class="cl-inbox-list-details-check" />
    <span class="checkmark"></span>
  </label>
  <div class="cl-inbox-list-details-wrap">
    <div class="cl-inbox-list-details-label">{{ subject }}</div>
    <div class="cl-inbox-list-details-description">{{ description }}</div>
  </div>
  <div class="cl-inbox-list-details-date">{{ date }}</div>
</div>
